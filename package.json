{
  "name": "ear-sky",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ear in the Sky Diamond — misheard lyrics from any language to any language",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"var f=require('fs'),p='dist/sw.js',d=new Date(Date.now()+9*3600000).toISOString().slice(0,10);f.writeFileSync(p,f.readFileSync(p,'utf8').replace('__BUILD_DATE__',d))\"",
    "preview": "vite preview",
    "check:mobile-overflow": "node scripts/check-mobile-overflow.mjs",
    "check:editor-ui": "node scripts/check-editor-ui.mjs"
  },
  "dependencies": {
    "hono": "^4.12.31",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260719.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/youtube": "^0.1.2",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.1.5",
    "wrangler": "^4.112.0"
  }
}
